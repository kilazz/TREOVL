import { TextEdit } from "std-widgets.slint";
import { CustomButton } from "../../components/buttons.slint";
import { SectionTitle } from "../../components/common.slint";

export component AnimationInspectorView inherits VerticalLayout {
    in property <string> info_text: "";
    in property <string> json_text: "";
    callback export_glb_clicked();
    callback export_json_clicked();

    spacing: 8px;
    vertical-stretch: 1;

    SectionTitle {
        text: "SKELETAL ANIMATION CLIP (TIMELINE & CHANNELS)";
        text-color: #f0b132;
    }

    HorizontalLayout {
        spacing: 8px;
        CustomButton {
            icon: "🎬";
            text: "Export to .GLB";
            primary-color: #3e6a90;
            min-w: 130px;
            clicked => { root.export_glb_clicked(); }
        }

        CustomButton {
            icon: "📋";
            text: "Export to .JSON";
            primary-color: #4e5058;
            min-w: 130px;
            clicked => { root.export_json_clicked(); }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            text: root.info_text;
            font-family: "Consolas";
            color: #cfcfcf;
            font-size: 11px;
            vertical-alignment: center;
        }
    }

    Rectangle {
        background: #111214;
        border-radius: 4px;
        border-width: 1px;
        border-color: #353535;
        vertical-stretch: 1;
        TextEdit {
            text: root.json_text;
            read-only: true;
            font-family: "Consolas";
            font-size: 11px;
        }
    }
}
