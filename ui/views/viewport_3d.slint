export component Viewport3DView inherits Rectangle {
    in property <image> preview_image;
    in property <bool> has_mesh: false;
    in property <[string]> stats_lines: [];
    callback rotate_viewport(float, float);

    background: #111214;
    border-radius: 4px;
    border-width: 1px;
    border-color: #353535;
    clip: true;
    vertical-stretch: 1;

    Image {
        source: root.preview_image;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }

    if !root.has_mesh: Text {
        text: "Select a 3D Mesh (.bin) to preview model in interactive 3D viewport";
        color: #808080;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    // Geometry Statistics HUD in TOP-LEFT corner
    if root.has_mesh && root.stats_lines.length > 0: Rectangle {
        x: 12px;
        y: 12px;
        width: 260px;
        background: #111317dd;
        border-radius: 6px;
        border-width: 1px;
        border-color: #2c323b;

        VerticalLayout {
            padding: 8px;
            spacing: 4px;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "📊 Geometry & Material Stats";
                    font-size: 11px;
                    font-weight: 700;
                    color: #f0b132;
                }
            }

            Rectangle {
                height: 1px;
                background: #2c323b;
            }

            for line in root.stats_lines: Text {
                text: line;
                font-family: "Consolas";
                font-size: 10px;
                color: #cfd3dc;
                overflow: elide;
            }
        }
    }

    property <length> drag_last_x: 0px;
    property <length> drag_last_y: 0px;
    property <bool> is_dragging: false;

    TouchArea {
        mouse-cursor: grab;
        moved => {
            if (self.pressed) {
                if (!is_dragging) {
                    is_dragging = true;
                    drag_last_x = self.mouse-x;
                    drag_last_y = self.mouse-y;
                } else {
                    let dx = (self.mouse-x - drag_last_x) / 1px;
                    let dy = (self.mouse-y - drag_last_y) / 1px;
                    drag_last_x = self.mouse-x;
                    drag_last_y = self.mouse-y;
                    if (dx != 0 || dy != 0) {
                        root.rotate_viewport(dx / 80.0, dy / 80.0);
                    }
                }
            } else {
                is_dragging = false;
            }
        }
    }
}
