export component Viewport3DView inherits Rectangle {
    in property <image> preview_image;
    in property <bool> has_mesh: false;
    in property <[string]> stats_lines: [];

    callback rotate_viewport(float, float);
    callback zoom_viewport(float);

    background: #111214;
    border-radius: 4px;
    border-width: 1px;
    border-color: #353535;
    clip: true;
    vertical-stretch: 1;

    Image {
        source: root.preview_image;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }

    if !root.has_mesh: Text {
        text: "Select a 3D Mesh (.bin) to preview model in interactive 3D viewport";
        color: #808080;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    // --- TOP-LEFT: GEOMETRY HUD ---
    if root.has_mesh && root.stats_lines.length > 0: Rectangle {
        x: 12px;
        y: 12px;
        width: 370px;
        height: hud_layout.preferred-height;
        background: #0f1115f0;
        border-radius: 6px;
        border-width: 1px;
        border-color: #2c323b;

        hud_layout := VerticalLayout {
            padding: 10px;
            spacing: 5px;
            alignment: start;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "📊 Geometry & Material Stats";
                    font-size: 12px;
                    font-weight: 700;
                    color: #f0b132;
                }
            }

            Rectangle {
                height: 1px;
                background: #2c323b;
            }

            for line in root.stats_lines: Text {
                text: line;
                font-family: "Consolas";
                font-size: 11.5px;
                color: #e2e4e9;
                overflow: elide;
            }
        }
    }

    property <length> drag_last_x: 0px;
    property <length> drag_last_y: 0px;
    property <bool> is_dragging: false;

    TouchArea {
        mouse-cursor: self.pressed ? grabbing : grab;

        scroll-event(event) => {
            root.zoom_viewport(event.delta-y / 1px);
            return accept;
        }

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                is_dragging = true;
                drag_last_x = self.mouse-x;
                drag_last_y = self.mouse-y;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                is_dragging = false;
            }
        }

        moved => {
            if (self.pressed && is_dragging) {
                let dx = (self.mouse-x - drag_last_x) / 1px;
                let dy = (self.mouse-y - drag_last_y) / 1px;
                drag_last_x = self.mouse-x;
                drag_last_y = self.mouse-y;
                if (dx != 0 || dy != 0) {
                    root.rotate_viewport(dx * 0.015, dy * 0.015);
                }
            }
        }
    }
}
