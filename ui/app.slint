import {
    TextEdit,
    Button,
    LineEdit,
    ListView,
    Slider,
} from "std-widgets.slint";
import { TabButton, CustomButton } from "./components/buttons.slint";
import { SectionTitle, SplitterBar } from "./components/common.slint";
import { Viewport3DView } from "./views/viewport_3d.slint";
import { JsonEditorView } from "./views/editor_view.slint";

export struct AssetItem {
    display_name: string,
    kind_name: string,
    icon: string,
    file_path: string,
    size_str: string,
    kind_id: int, // 0: Texture, 1: Audio, 2: Material, 3: Mesh, 4: Lua, 5: Generic, 6: UI, 7: Object, 8: Animation, 9: TerrainPalette, 10: Collision, 11: Environment, 12: M8LD Map Logic, 13: UI Sprite Collection, 14: Lighting Set (.dta), 15: Voice Package (.debug-vpk)
    is_modified: bool,
}

export component AppWindow inherits Window {
    title: "Overlord Modding Studio — Workspace";
    min-width: 1080px;
    min-height: 720px;
    preferred-width: 1360px;
    preferred-height: 860px;
    background: #141414;

    // View Tabs: 0 = Workspace, 1 = Terminal Log
    in-out property <int> active_tab: 0;
    in-out property <length> sidebar_width: 440px;

    // Toolbox Subcategory Tab: 0 = Localization, 1 = Lighting & Env, 2 = 3D & Maps, 3 = Collisions & Fonts, 4 = Textures & Audio
    in-out property <int> active_toolbox_tab: 0;

    // Workspace Data
    in-out property <string> active_project_dir: "";
    in-out property <[AssetItem]> asset_list: [];
    in-out property <string> filter_text: "";
    in-out property <int> selected_index: -1;
    in-out property <int> active_kind_id: 5;
    in-out property <string> active_file_path: "";
    in-out property <string> status_msg: "Ready.";
    in-out property <bool> status_is_error: false;
    in-out property <string> log_text: "System Ready.\n";

    // 3D Viewport Controls & Composite State
    in-out property <float> viewport_fov: 45.0;
    in-out property <int> viewport_lighting: 0;
    in-out property <int> viewport_up_axis: 1; // 1: Game (+90° Upright), 0: Raw (As-is), 2: Invert (-90°)
    in-out property <bool> has_composite_available: false;
    in-out property <bool> is_composite_active: false;

    // Active Asset Inspector States
    in-out property <image> tex_preview;
    in-out property <string> tex_info: "No texture loaded.";
    in-out property <bool> has_texture: false;
    in-out property <image> mesh_preview;
    in-out property <bool> has_mesh: false;
    in-out property <string> mat_json_text: "";
    in-out property <string> mesh_info: "No mesh loaded.";
    in-out property <[string]> mesh_stats_lines: [];

    // File Dialog Callbacks
    callback browse_file() -> string;
    callback browse_folder() -> string;
    callback save_file() -> string;

    // Core Project Callbacks
    callback unpack_prp(string, string);
    callback pack_prp(string);
    callback load_project(string);
    callback clean_rebuild(string);
    callback revert_asset(string);
    callback open_assets_folder(string);
    callback create_patch(string, string, string);
    callback apply_patch(string, string);
    callback select_asset(int);
    callback filter_changed(string);

    // Interactive 3D Viewport Orbit & Camera Callbacks
    callback rotate_mesh_viewport(float, float);
    callback zoom_mesh_viewport(float);
    callback set_viewport_fov(float);
    callback set_viewport_lighting(int);
    callback set_viewport_up_axis(int);
    callback reset_viewport_camera();
    callback toggle_composite_view();

    // Contextual Asset Operations Callbacks (for loaded project chunks)
    callback export_dds(string, string);
    callback import_dds(string, string);
    callback export_wav(string, string);
    callback import_wav(string, string);
    callback save_material(string, string);
    callback save_ui(string, string);
    callback save_object(string, string);
    callback save_terrain_palette(string, string);
    callback save_environment(string, string);
    callback save_m8ld(string, string);
    callback save_ui_sprite(string, string);
    callback save_dta(string, string);
    callback save_vpk(string, string);
    callback export_mesh_obj(string, string);
    callback import_mesh_obj(string, string);
    callback export_terrain_obj(string, string);
    callback export_collision_glb(string, string);
    callback import_collision_glb(string, string);
    callback export_lua(string, string);
    callback import_lua(string, string);
    callback export_anim_glb(string, string);
    callback export_anim_json(string, string);

    // Standalone Direct File Operations (Global Toolbox)
    callback decompile_8ld(string, string);
    callback compile_8ld(string, string);
    callback decompile_8ld_batch(string, string);
    callback compile_8ld_batch(string, string);

    callback direct_vpk_to_json(string, string);
    callback direct_json_to_vpk(string, string, string);

    callback direct_dta_to_json(string, string);
    callback direct_json_to_dta(string, string, string);
    callback direct_env_to_json(string, string);
    callback direct_json_to_env(string, string, string);

    callback direct_mesh_export(string, string);
    callback direct_mesh_import(string, string);
    callback direct_assemble_level(string, string, string);
    callback direct_terrain_export(string, string);

    callback direct_collision_export(string, string);
    callback direct_collision_import(string, string);
    callback direct_font_to_json(string, string);
    callback direct_json_to_font(string, string);

    callback direct_texture_export(string, string);
    callback direct_texture_import(string, string);
    callback direct_audio_export(string, string);
    callback direct_audio_import(string, string);

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // TOP NAVIGATION TAB BAR
        HorizontalLayout {
            spacing: 6px;
            height: 30px;

            TabButton {
                text: "Studio Workspace";
                active: root.active_tab == 0;
                accent-color: #f0b132;
                clicked => { root.active_tab = 0; }
            }

            TabButton {
                text: "Terminal Log";
                active: root.active_tab == 1;
                accent-color: #3e6a90;
                clicked => { root.active_tab = 1; }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            if root.active_project_dir != "": Text {
                text: "Project: " + root.active_project_dir;
                font-family: "Consolas";
                font-size: 11px;
                color: #f0b132;
                vertical-alignment: center;
                overflow: elide;
                max-width: 400px;
            }

            Text {
                text: "Items: " + root.asset_list.length;
                font-family: "Consolas";
                font-size: 11px;
                color: #cfcfcf;
                vertical-alignment: center;
            }
        }

        // TAB 0: UNIFIED WORKSPACE
        if root.active_tab == 0: VerticalLayout {
            spacing: 10px;

            // QUICK ACTIONS TOOLBAR (ORGANIZED IN 3 ROWS)
            Rectangle {
                height: 114px;
                background: #2b2d31;
                border-color: #1f2023;
                border-width: 1px;
                border-radius: 6px;

                VerticalLayout {
                    padding: 8px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    alignment: center;

                    // ROW 1: PROJECT & ARCHIVE WORKFLOW
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        CustomButton {
                            icon: "📦";
                            text: "Unpack PRP...";
                            primary-color: #3e6a90;
                            min-w: 125px;
                            clicked => {
                                let src = root.browse_file();
                                if (src != "") {
                                    let dst = root.browse_folder();
                                    if (dst != "") { root.unpack_prp(src, dst); }
                                }
                            }
                        }

                        CustomButton {
                            icon: "📂";
                            text: "Open Project...";
                            primary-color: #4e5058;
                            min-w: 130px;
                            clicked => {
                                let path = root.browse_folder();
                                if (path != "") { root.load_project(path); }
                                else { let f = root.browse_file(); if (f != "") { root.load_project(f); } }
                            }
                        }

                        CustomButton {
                            icon: "📁";
                            text: "Assets Folder";
                            primary-color: #d28e1b;
                            min-w: 125px;
                            clicked => {
                                if (root.active_project_dir != "") { root.open_assets_folder(root.active_project_dir); }
                                else { let proj = root.browse_folder(); if (proj != "") { root.open_assets_folder(proj); } }
                            }
                        }

                        CustomButton {
                            icon: "🧹";
                            text: "Clean Rebuild";
                            primary-color: #636773;
                            min-w: 125px;
                            clicked => {
                                if (root.active_project_dir != "") { root.clean_rebuild(root.active_project_dir); }
                                else { let proj = root.browse_folder(); if (proj != "") { root.clean_rebuild(proj); } }
                            }
                        }

                        CustomButton {
                            icon: "💾";
                            text: "Pack to PRP";
                            primary-color: #23a55a;
                            min-w: 120px;
                            clicked => {
                                if (root.active_project_dir != "") { root.pack_prp(root.active_project_dir); }
                                else { let proj = root.browse_folder(); if (proj != "") { root.pack_prp(proj); } }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 1px;
                                background: #3f4248;
                                height: 20px;
                            }
                        }

                        CustomButton {
                            icon: "🩹";
                            text: "Create Patch...";
                            primary-color: #4e5058;
                            min-w: 125px;
                            clicked => {
                                let base = root.browse_folder();
                                if (base != "") {
                                    let mod_dir = root.browse_folder();
                                    if (mod_dir != "") {
                                        let out = root.save_file();
                                        if (out != "") { root.create_patch(base, mod_dir, out); }
                                    }
                                }
                            }
                        }

                        CustomButton {
                            icon: "✨";
                            text: "Apply Patch...";
                            primary-color: #3e6a90;
                            min-w: 120px;
                            clicked => {
                                let patch = root.browse_file();
                                if (patch != "") {
                                    let target = root.browse_folder();
                                    if (target != "") { root.apply_patch(target, patch); }
                                }
                            }
                        }
                    }

                    // ROW 2: CATEGORY SELECTOR CHIPS
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        height: 22px;

                        Text {
                            text: "Toolbox:";
                            font-family: "Consolas";
                            font-size: 11px;
                            font-weight: 700;
                            color: #949ba4;
                            vertical-alignment: center;
                            width: 65px;
                        }

                        // Tab 0: Localization
                        Rectangle {
                            background: root.active_toolbox_tab == 0 ? #3e6a90 : (c0_ta.has-hover ? #2e3035 : #202124);
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: root.active_toolbox_tab == 0 ? #58a6ff : #353535;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: "🌐 Localization";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: root.active_toolbox_tab == 0 ? #ffffff : #c0c0c0;
                                    vertical-alignment: center;
                                }
                            }

                            c0_ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.active_toolbox_tab = 0; }
                            }
                        }

                        // Tab 1: Lighting & Env
                        Rectangle {
                            background: root.active_toolbox_tab == 1 ? #d28e1b : (c1_ta.has-hover ? #2e3035 : #202124);
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: root.active_toolbox_tab == 1 ? #f0b132 : #353535;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: "💡 Lighting & Env";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: root.active_toolbox_tab == 1 ? #ffffff : #c0c0c0;
                                    vertical-alignment: center;
                                }
                            }

                            c1_ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.active_toolbox_tab = 1; }
                            }
                        }

                        // Tab 2: 3D Models & Maps
                        Rectangle {
                            background: root.active_toolbox_tab == 2 ? #23a55a : (c2_ta.has-hover ? #2e3035 : #202124);
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: root.active_toolbox_tab == 2 ? #57f287 : #353535;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: "🗿 3D & Maps";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: root.active_toolbox_tab == 2 ? #ffffff : #c0c0c0;
                                    vertical-alignment: center;
                                }
                            }

                            c2_ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.active_toolbox_tab = 2; }
                            }
                        }

                        // Tab 3: Collisions & Fonts
                        Rectangle {
                            background: root.active_toolbox_tab == 3 ? #5865f2 : (c3_ta.has-hover ? #2e3035 : #202124);
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: root.active_toolbox_tab == 3 ? #7983f5 : #353535;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: "🧱 Collision & Fonts";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: root.active_toolbox_tab == 3 ? #ffffff : #c0c0c0;
                                    vertical-alignment: center;
                                }
                            }

                            c3_ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.active_toolbox_tab = 3; }
                            }
                        }

                        // Tab 4: Textures & Audio
                        Rectangle {
                            background: root.active_toolbox_tab == 4 ? #b57a16 : (c4_ta.has-hover ? #2e3035 : #202124);
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: root.active_toolbox_tab == 4 ? #f0b132 : #353535;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: "🎨 Textures & Audio";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: root.active_toolbox_tab == 4 ? #ffffff : #c0c0c0;
                                    vertical-alignment: center;
                                }
                            }

                            c4_ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.active_toolbox_tab = 4; }
                            }
                        }
                    }

                    // ROW 3: CONTEXTUAL ACTIONS FOR SELECTED TOOLBOX CATEGORY
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        // --- CATEGORY 0: LOCALIZATION ---
                        if root.active_toolbox_tab == 0: HorizontalLayout {
                            spacing: 6px;
                            CustomButton {
                                icon: "🔓";
                                text: "8LD -> XML (1 file)";
                                primary-color: #d28e1b;
                                min-w: 150px;
                                clicked => {
                                    let src = root.browse_file();
                                    if (src != "") { let dst = root.browse_folder(); if (dst != "") { root.decompile_8ld(src, dst); } }
                                }
                            }

                            CustomButton {
                                icon: "🗂️";
                                text: "8LD -> XML (Batch)";
                                primary-color: #b57a16;
                                min-w: 155px;
                                clicked => {
                                    let src = root.browse_folder();
                                    if (src != "") { let dst = root.browse_folder(); if (dst != "") { root.decompile_8ld_batch(src, dst); } }
                                }
                            }

                            CustomButton {
                                icon: "🔒";
                                text: "XML -> 8LD (1 file)";
                                primary-color: #23a55a;
                                min-w: 150px;
                                clicked => {
                                    let src = root.browse_file();
                                    if (src != "") { let dst = root.browse_folder(); if (dst != "") { root.compile_8ld(src, dst); } }
                                }
                            }

                            CustomButton {
                                icon: "📦";
                                text: "XML -> 8LD (Batch)";
                                primary-color: #1c8849;
                                min-w: 155px;
                                clicked => {
                                    let src = root.browse_folder();
                                    if (src != "") { let dst = root.browse_folder(); if (dst != "") { root.compile_8ld_batch(src, dst); } }
                                }
                            }

                            CustomButton {
                                icon: "🗣️";
                                text: "VPK -> JSON";
                                primary-color: #3e6a90;
                                min-w: 135px;
                                clicked => {
                                    let src = root.browse_file();
                                    if (src != "") { let dst = root.save_file(); if (dst != "") { root.direct_vpk_to_json(src, dst); } }
                                }
                            }

                            CustomButton {
                                icon: "🔒";
                                text: "JSON -> VPK";
                                primary-color: #1c8849;
                                min-w: 135px;
                                clicked => {
                                    let json_src = root.browse_file();
                                    if (json_src != "") {
                                        let base = root.browse_file();
                                        if (base != "") { let out = root.save_file(); if (out != "") { root.direct_json_to_vpk(json_src, base, out); } }
                                    }
                                }
                            }
                        }

                        // --- CATEGORY 1: LIGHTING & ENVIRONMENT ---
                        if root.active_toolbox_tab == 1: HorizontalLayout {
                            spacing: 6px;
                            CustomButton {
                                icon: "💡";
                                text: "DTA -> JSON";
                                primary-color: #d28e1b;
                                min-w: 135px;
                                clicked => {
                                    let src = root.browse_file();
                                    if (src != "") { let dst = root.save_file(); if (dst != "") { root.direct_dta_to_json(src, dst); } }
                                }
                            }

                            CustomButton {
                                icon: "🔒";
                                text: "JSON -> DTA";
                                primary-color: #23a55a;
                                min-w: 135px;
                                clicked => {
                                    let json_src = root.browse_file();
                                    if (json_src != "") {
                                        let base = root.browse_file();
                                        if (base != "") { let out = root.save_file(); if (out != "") { root.direct_json_to_dta(json_src, base, out); } }
                                    }
                                }
                            }

                            CustomButton {
                                icon: "🌌";
                                text: "ENV -> JSON";
                                primary-color: #3e6a90;
                                min-w: 135px;
                                clicked => {
                                    let src = root.browse_file();
                                    if (src != "") { let dst = root.save_file(); if (dst != "") { root.direct_env_to_json(src, dst); } }
                                }
                            }

                            CustomButton {
                                icon: "💾";
                                text: "JSON -> ENV";
                                primary-color: #1c8849;
                                min-w: 135px;
                                clicked => {
                                    let json_src = root.browse_file();
                                    if (json_src != "") {
                                        let base = root.browse_file();
                                        if (base != "") { let out = root.save_file(); if (out != "") { root.direct_json_to_env(json_src, base, out); } }
                                    }
                                }
                            }
                        }

                        // --- CATEGORY 2: 3D MODELS & LEVEL MAPS ---
                        if root.active_toolbox_tab == 2: HorizontalLayout {
                            spacing: 6px;
                            CustomButton {
                                icon: "🗿";
                                text: "Mesh -> GLB/OBJ";
                                primary-color: #3e6a90;
                                min-w: 145px;
                                clicked => {
                                    let src = root.browse_file();
                                    if (src != "") { let dst = root.save_file(); if (dst != "") { root.direct_mesh_export(src, dst); } }
                                }
                            }

                            CustomButton {
                                icon: "📥";
                                text: "Inject 3D into Mesh";
                                primary-color: #23a55a;
                                min-w: 155px;
                                clicked => {
                                    let target_chunk = root.browse_file();
                                    if (target_chunk != "") {
                                        let model = root.browse_file();
                                        if (model != "") { root.direct_mesh_import(target_chunk, model); }
                                    }
                                }
                            }

                            CustomButton {
                                icon: "🗺️";
                                text: "Assemble Level (OMP -> GLB)";
                                primary-color: #d28e1b;
                                min-w: 200px;
                                clicked => {
                                    let omp = root.browse_file();
                                    if (omp != "") {
                                        let assets = root.browse_folder();
                                        if (assets != "") { let out = root.save_file(); if (out != "") { root.direct_assemble_level(omp, assets, out); } }
                                    }
                                }
                            }

                            CustomButton {
                                icon: "⛰️";
                                text: "Terrain -> GLB";
                                primary-color: #4e5058;
                                min-w: 135px;
                                clicked => {
                                    let src = root.browse_file();
                                    if (src != "") { let dst = root.save_file(); if (dst != "") { root.direct_terrain_export(src, dst); } }
                                }
                            }
                        }

                        // --- CATEGORY 3: COLLISIONS & FONTS ---
                        if root.active_toolbox_tab == 3: HorizontalLayout {
                            spacing: 6px;
                            CustomButton {
                                icon: "🧱";
                                text: "Collision -> 3D GLB";
                                primary-color: #3e6a90;
                                min-w: 160px;
                                clicked => {
                                    let src = root.browse_file();
                                    if (src != "") { let dst = root.save_file(); if (dst != "") { root.direct_collision_export(src, dst); } }
                                }
                            }

                            CustomButton {
                                icon: "📥";
                                text: "Inject GLB into Collision";
                                primary-color: #23a55a;
                                min-w: 175px;
                                clicked => {
                                    let target_chunk = root.browse_file();
                                    if (target_chunk != "") {
                                        let glb = root.browse_file();
                                        if (glb != "") { root.direct_collision_import(target_chunk, glb); }
                                    }
                                }
                            }

                            CustomButton {
                                icon: "🔤";
                                text: "Font CLB -> JSON";
                                primary-color: #5865f2;
                                min-w: 150px;
                                clicked => {
                                    let src = root.browse_file();
                                    if (src != "") { let dst = root.save_file(); if (dst != "") { root.direct_font_to_json(src, dst); } }
                                }
                            }

                            CustomButton {
                                icon: "🔒";
                                text: "JSON -> Font CLB";
                                primary-color: #1c8849;
                                min-w: 150px;
                                clicked => {
                                    let src = root.browse_file();
                                    if (src != "") { let dst = root.save_file(); if (dst != "") { root.direct_json_to_font(src, dst); } }
                                }
                            }
                        }

                        // --- CATEGORY 4: TEXTURES & AUDIO ---
                        if root.active_toolbox_tab == 4: HorizontalLayout {
                            spacing: 6px;
                            CustomButton {
                                icon: "🎨";
                                text: "Texture -> DDS/TGA";
                                primary-color: #3e6a90;
                                min-w: 160px;
                                clicked => {
                                    let src = root.browse_file();
                                    if (src != "") { let dst = root.save_file(); if (dst != "") { root.direct_texture_export(src, dst); } }
                                }
                            }

                            CustomButton {
                                icon: "📥";
                                text: "Inject DDS into Texture";
                                primary-color: #23a55a;
                                min-w: 175px;
                                clicked => {
                                    let target_chunk = root.browse_file();
                                    if (target_chunk != "") {
                                        let img = root.browse_file();
                                        if (img != "") { root.direct_texture_import(target_chunk, img); }
                                    }
                                }
                            }

                            CustomButton {
                                icon: "🎵";
                                text: "Audio -> WAV";
                                primary-color: #d28e1b;
                                min-w: 135px;
                                clicked => {
                                    let src = root.browse_file();
                                    if (src != "") { let dst = root.save_file(); if (dst != "") { root.direct_audio_export(src, dst); } }
                                }
                            }

                            CustomButton {
                                icon: "📥";
                                text: "Inject WAV into Audio";
                                primary-color: #1c8849;
                                min-w: 165px;
                                clicked => {
                                    let target_chunk = root.browse_file();
                                    if (target_chunk != "") {
                                        let wav = root.browse_file();
                                        if (wav != "") { root.direct_audio_import(target_chunk, wav); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // WORKSPACE MAIN SPLITTER AREA
            HorizontalLayout {
                spacing: 0px;

                // --- LEFT EXPLORER SIDEBAR ---
                Rectangle {
                    width: root.sidebar_width;
                    background: #2b2d31;
                    border-color: #1f2023;
                    border-width: 1px;
                    border-radius: 4px;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        LineEdit {
                            text <=> root.filter_text;
                            placeholder-text: "🔍 Filter resources by name, ID or type...";
                            font-family: "Consolas";
                            font-size: 11px;
                            edited(text) => { root.filter_changed(text); }
                        }

                        Rectangle {
                            background: #111214;
                            border-radius: 4px;
                            clip: true;
                            vertical-stretch: 1;

                            ListView {
                                for item[idx] in root.asset_list: Rectangle {
                                    height: 34px;
                                    background: root.selected_index == idx ? #3e6a90 : (ta.has-hover ? #2c3e50 : (Math.mod(idx, 2) == 0 ? #18191b : #141517));

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;

                                        Text {
                                            text: item.icon;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 1px;
                                            horizontal-stretch: 1;

                                            HorizontalLayout {
                                                spacing: 4px;
                                                Text {
                                                    text: item.display_name;
                                                    color: #ffffff;
                                                    font-family: "Consolas";
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    overflow: elide;
                                                }

                                                if item.is_modified: Text {
                                                    text: "[MOD]";
                                                    color: #f0b132;
                                                    font-family: "Consolas";
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            Text {
                                                text: item.kind_name + " • " + item.size_str;
                                                color: root.selected_index == idx ? #dcdcdc : #949ba4;
                                                font-size: 10px;
                                            }
                                        }
                                    }

                                    ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.select_asset(idx); }
                                    }
                                }
                            }
                        }
                    }
                }

                SplitterBar {
                    target-width <=> root.sidebar_width;
                }

                // --- RIGHT DYNAMIC INSPECTOR PANE ---
                Rectangle {
                    horizontal-stretch: 1;
                    background: #18191b;
                    border-color: #1f2023;
                    border-width: 1px;
                    border-radius: 4px;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: root.selected_index >= 0 && root.selected_index < root.asset_list.length ? root.asset_list[root.selected_index].display_name : "No Resource Selected";
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: #f0b132;
                                }

                                Text {
                                    text: root.active_file_path != "" ? root.active_file_path : "Select any item from the left resource explorer to inspect and edit.";
                                    font-family: "Consolas";
                                    font-size: 11px;
                                    color: #949ba4;
                                }
                            }

                            if root.active_file_path != "": CustomButton {
                                icon: "🔄";
                                text: "Reset to Vanilla";
                                primary-color: #8b3a3a;
                                min-w: 135px;
                                clicked => { root.revert_asset(root.active_file_path); }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: #353535;
                        }

                        // Context 0: Textures
                        if root.active_kind_id == 0: VerticalLayout {
                            spacing: 10px;
                            vertical-stretch: 1;

                            HorizontalLayout {
                                spacing: 8px;
                                CustomButton {
                                    icon: "📥";
                                    text: "Export to Image";
                                    primary-color: #3e6a90;
                                    min-w: 130px;
                                    clicked => { let out = root.save_file(); if (out != "") { root.export_dds(root.active_file_path, out); } }
                                }

                                CustomButton {
                                    icon: "📤";
                                    text: "Replace from Image";
                                    primary-color: #23a55a;
                                    min-w: 140px;
                                    clicked => { let inp = root.browse_file(); if (inp != "") { root.import_dds(root.active_file_path, inp); } }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: root.tex_info;
                                    font-family: "Consolas";
                                    color: #cfcfcf;
                                    vertical-alignment: center;
                                    font-size: 11px;
                                }
                            }

                            Rectangle {
                                background: #111214;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #353535;
                                clip: true;
                                vertical-stretch: 1;
                                Image {
                                    source: root.tex_preview;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                }
                            }
                        }

                        // Context 1: Audio
                        if root.active_kind_id == 1: VerticalLayout {
                            spacing: 12px;
                            alignment: start;
                            SectionTitle {
                                text: "AUDIO EXTRACTION & REPLACEMENT";
                                text-color: #3e6a90;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                CustomButton {
                                    icon: "📥";
                                    text: "Export to .WAV";
                                    primary-color: #3e6a90;
                                    min-w: 125px;
                                    clicked => { let out = root.save_file(); if (out != "") { root.export_wav(root.active_file_path, out); } }
                                }

                                CustomButton {
                                    icon: "📤";
                                    text: "Replace from .WAV";
                                    primary-color: #23a55a;
                                    min-w: 135px;
                                    clicked => { let inp = root.browse_file(); if (inp != "") { root.import_wav(root.active_file_path, inp); } }
                                }
                            }
                        }

                        // Context 2: Materials
                        if root.active_kind_id == 2: JsonEditorView {
                            title_text: "MATERIAL PROPERTIES EDITOR (SHADERS & TEXTURES)";
                            title_color: #f0b132;
                            save_btn_text: "Save Changes to Material";
                            content <=> root.mat_json_text;
                            save_clicked => { root.save_material(root.active_file_path, root.mat_json_text); }
                        }

                        // Context 3: 3D Mesh / Composite Viewport
                        if root.active_kind_id == 3: VerticalLayout {
                            spacing: 8px;
                            vertical-stretch: 1;

                            SectionTitle {
                                text: "3D GEOMETRY, PERSPECTIVE VIEWPORT & SHADING";
                                text-color: #f0b132;
                            }

                            // --- ROW 1: FILE & MESH OPERATIONS ---
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                height: 32px;

                                CustomButton {
                                    icon: "🗿";
                                    text: "Export 3D";
                                    primary-color: #3e6a90;
                                    min-w: 120px;
                                    clicked => { let out = root.save_file(); if (out != "") { root.export_mesh_obj(root.active_file_path, out); } }
                                }

                                CustomButton {
                                    icon: "📤";
                                    text: "Replace 3D";
                                    primary-color: #23a55a;
                                    min-w: 125px;
                                    clicked => { let inp = root.browse_file(); if (inp != "") { root.import_mesh_obj(root.active_file_path, inp); } }
                                }

                                CustomButton {
                                    icon: "⛰️";
                                    text: "Terrain 3D";
                                    primary-color: #4e5058;
                                    min-w: 120px;
                                    clicked => { let out = root.save_file(); if (out != "") { root.export_terrain_obj(root.active_file_path, out); } }
                                }

                                if root.has_composite_available: CustomButton {
                                    icon: "👥";
                                    text: root.is_composite_active ? "Composite ON" : "Composite Full";
                                    primary-color: root.is_composite_active ? #23a55a : #3e6a90;
                                    min-w: 140px;
                                    clicked => { root.toggle_composite_view(); }
                                }
                            }

                            // --- ROW 2: VIEWPORT NAVIGATION & SHADING TOOLBAR ---
                            Rectangle {
                                background: #20242c;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #353535;
                                height: 40px;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    alignment: space-between;

                                    // Left: Camera Controls (Fit, Zoom +, -, Axis Mode)
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;
                                        height: 40px;

                                        Rectangle {
                                            width: 58px;
                                            height: 26px;
                                            y: (parent.height - self.height) / 2;
                                            background: fit_ta.has-hover ? #3e6a90 : #2b303c;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: #3e4450;
                                            Text {
                                                text: "🎯 Fit";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: #ffffff;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }

                                            fit_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.reset_viewport_camera(); }
                                            }
                                        }

                                        Rectangle {
                                            width: 28px;
                                            height: 26px;
                                            y: (parent.height - self.height) / 2;
                                            background: zin_ta.has-hover ? #3e6a90 : #2b303c;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: #3e4450;
                                            Text {
                                                text: "+";
                                                font-size: 14px;
                                                font-weight: 700;
                                                color: #ffffff;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }

                                            zin_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.zoom_mesh_viewport(1.0); }
                                            }
                                        }

                                        Rectangle {
                                            width: 28px;
                                            height: 26px;
                                            y: (parent.height - self.height) / 2;
                                            background: zout_ta.has-hover ? #3e6a90 : #2b303c;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: #3e4450;
                                            Text {
                                                text: "–";
                                                font-size: 14px;
                                                font-weight: 700;
                                                color: #ffffff;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }

                                            zout_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.zoom_mesh_viewport(-1.0); }
                                            }
                                        }

                                        // 3-way axis cycler: Mode 1 (+90° Upright) -> Mode 0 (Raw) -> Mode 2 (-90° Invert)
                                        Rectangle {
                                            width: 130px;
                                            height: 26px;
                                            y: (parent.height - self.height) / 2;
                                            background: root.viewport_up_axis == 1 ? #23a55a : (root.viewport_up_axis == 2 ? #d28e1b : #2b303c);
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: root.viewport_up_axis == 1 ? #57f287 : (root.viewport_up_axis == 2 ? #f0b132 : #3e4450);
                                            Text {
                                                text: root.viewport_up_axis == 1 ? "📐 Game (+90°)" : (root.viewport_up_axis == 2 ? "📐 Invert (-90°)" : "📐 Raw (As-is)");
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: #ffffff;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }

                                            up_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if (root.viewport_up_axis == 1) {
                                                        root.viewport_up_axis = 0;
                                                    } else if (root.viewport_up_axis == 0) {
                                                        root.viewport_up_axis = 2;
                                                    } else {
                                                        root.viewport_up_axis = 1;
                                                    }
                                                    root.set_viewport_up_axis(root.viewport_up_axis);
                                                }
                                            }
                                        }
                                    }

                                    // Middle: FOV Slider
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;
                                        height: 40px;

                                        Text {
                                            text: "FOV:";
                                            font-family: "Consolas";
                                            font-size: 11px;
                                            color: #cfcfcf;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: Math.round(root.viewport_fov) + "°";
                                            font-family: "Consolas";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: #f0b132;
                                            vertical-alignment: center;
                                            width: 32px;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            height: 40px;
                                            width: 110px;
                                            Slider {
                                                minimum: 25.0;
                                                maximum: 85.0;
                                                value <=> root.viewport_fov;
                                                changed(val) => { root.set_viewport_fov(val); }
                                            }
                                        }
                                    }

                                    // Right: Shading Modes (Studio, Bright, Unlit)
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: center;
                                        height: 40px;

                                        Rectangle {
                                            width: 76px;
                                            height: 26px;
                                            y: (parent.height - self.height) / 2;
                                            background: root.viewport_lighting == 0 ? #23a55a : (l0_ta.has-hover ? #3e4450 : #2b303c);
                                            border-radius: 4px;
                                            Text {
                                                text: "☀️ Studio";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: #ffffff;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }

                                            l0_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.viewport_lighting = 0;
                                                    root.set_viewport_lighting(0);
                                                }
                                            }
                                        }

                                        Rectangle {
                                            width: 70px;
                                            height: 26px;
                                            y: (parent.height - self.height) / 2;
                                            background: root.viewport_lighting == 1 ? #d28e1b : (l1_ta.has-hover ? #3e4450 : #2b303c);
                                            border-radius: 4px;
                                            Text {
                                                text: "💡 Bright";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: #ffffff;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }

                                            l1_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.viewport_lighting = 1;
                                                    root.set_viewport_lighting(1);
                                                }
                                            }
                                        }

                                        Rectangle {
                                            width: 65px;
                                            height: 26px;
                                            y: (parent.height - self.height) / 2;
                                            background: root.viewport_lighting == 2 ? #5865f2 : (l2_ta.has-hover ? #3e4450 : #2b303c);
                                            border-radius: 4px;
                                            Text {
                                                text: "🎨 Unlit";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: #ffffff;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }

                                            l2_ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.viewport_lighting = 2;
                                                    root.set_viewport_lighting(2);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Viewport3DView {
                                preview_image: root.mesh_preview;
                                has_mesh: root.has_mesh;
                                stats_lines: root.mesh_stats_lines;
                                rotate_viewport(dyaw, dpitch) => { root.rotate_mesh_viewport(dyaw, dpitch); }
                                zoom_viewport(delta) => { root.zoom_mesh_viewport(delta); }
                            }
                        }

                        // Context 4: Lua Script
                        if root.active_kind_id == 4: VerticalLayout {
                            spacing: 12px;
                            alignment: start;
                            SectionTitle {
                                text: "COMPILED SCRIPT (LUA 5.0.2)";
                                text-color: #f0b132;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                CustomButton {
                                    icon: "📥";
                                    text: "Export to .luac";
                                    primary-color: #3e6a90;
                                    min-w: 125px;
                                    clicked => { let out = root.save_file(); if (out != "") { root.export_lua(root.active_file_path, out); } }
                                }

                                CustomButton {
                                    icon: "📤";
                                    text: "Replace from .luac";
                                    primary-color: #23a55a;
                                    min-w: 135px;
                                    clicked => { let inp = root.browse_file(); if (inp != "") { root.import_lua(root.active_file_path, inp); } }
                                }
                            }
                        }

                        // Context 5: Generic Raw
                        if root.active_kind_id == 5: VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.selected_index >= 0 ? "Generic data chunk. Raw binary operations only." : "No resource selected. Click an item in the left explorer.";
                                color: #808080;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }

                        // Context 6: UI Layout
                        if root.active_kind_id == 6: JsonEditorView {
                            title_text: "UI LAYOUT EDITOR (MENU & HUD)";
                            title_color: #63d297;
                            save_btn_text: "Save Changes to UI Layout";
                            content <=> root.mat_json_text;
                            save_clicked => { root.save_ui(root.active_file_path, root.mat_json_text); }
                        }

                        // Context 7: 3D Object Entity
                        if root.active_kind_id == 7: JsonEditorView {
                            title_text: "3D OBJECT ENTITY EDITOR (SCENE GRAPH & PREFABS)";
                            title_color: #3e6a90;
                            save_btn_text: "Save Changes to Object Entity";
                            content <=> root.mat_json_text;
                            save_clicked => { root.save_object(root.active_file_path, root.mat_json_text); }
                        }

                        // Context 8: Animation Clip
                        if root.active_kind_id == 8: VerticalLayout {
                            spacing: 8px;
                            vertical-stretch: 1;
                            SectionTitle {
                                text: "SKELETAL ANIMATION CLIP (TIMELINE & CHANNELS)";
                                text-color: #f0b132;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                CustomButton {
                                    icon: "🎬";
                                    text: "Export to .GLB";
                                    primary-color: #3e6a90;
                                    min-w: 130px;
                                    clicked => { let out = root.save_file(); if (out != "") { root.export_anim_glb(root.active_file_path, out); } }
                                }

                                CustomButton {
                                    icon: "📋";
                                    text: "Export to .JSON";
                                    primary-color: #4e5058;
                                    min-w: 130px;
                                    clicked => { let out = root.save_file(); if (out != "") { root.export_anim_json(root.active_file_path, out); } }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: root.mesh_info;
                                    font-family: "Consolas";
                                    color: #cfcfcf;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                background: #111214;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #353535;
                                vertical-stretch: 1;
                                TextEdit {
                                    text <=> root.mat_json_text;
                                    read-only: true;
                                    font-family: "Consolas";
                                    font-size: 11px;
                                }
                            }
                        }

                        // Context 9: Terrain Palette
                        if root.active_kind_id == 9: JsonEditorView {
                            title_text: "TERRAIN TEXTURE PALETTE & BIOME EDITOR";
                            title_color: #f0b132;
                            save_btn_text: "Save Changes to Terrain Palette";
                            content <=> root.mat_json_text;
                            save_clicked => { root.save_terrain_palette(root.active_file_path, root.mat_json_text); }
                        }

                        // Context 10: 3D Collision (.clb)
                        if root.active_kind_id == 10: VerticalLayout {
                            spacing: 10px;
                            vertical-stretch: 1;
                            SectionTitle {
                                text: "3D COLLISION BOUNDARY EDITOR (.CLB / OBB)";
                                text-color: #4CAF50;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                CustomButton {
                                    icon: "🧱";
                                    text: "Export to 3D .GLB";
                                    primary-color: #3e6a90;
                                    min-w: 145px;
                                    clicked => { let out = root.save_file(); if (out != "") { root.export_collision_glb(root.active_file_path, out); } }
                                }

                                CustomButton {
                                    icon: "📤";
                                    text: "Replace from 3D .GLB";
                                    primary-color: #23a55a;
                                    min-w: 155px;
                                    clicked => { let inp = root.browse_file(); if (inp != "") { root.import_collision_glb(root.active_file_path, inp); } }
                                }
                            }

                            Rectangle {
                                background: #111214;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #353535;
                                vertical-stretch: 1;
                                TextEdit {
                                    text <=> root.mat_json_text;
                                    font-family: "Consolas";
                                    font-size: 11px;
                                }
                            }
                        }

                        // Context 11: Environment (.env)
                        if root.active_kind_id == 11: JsonEditorView {
                            title_text: "ENVIRONMENT, SKY & POST-PROCESSING PROFILE (.ENV)";
                            title_color: #63d297;
                            save_btn_text: "Save Changes to Environment Profile";
                            content <=> root.mat_json_text;
                            save_clicked => { root.save_environment(root.active_file_path, root.mat_json_text); }
                        }

                        // Context 12: M8LD Map XML
                        if root.active_kind_id == 12: JsonEditorView {
                            title_text: "LEVEL LOGIC, DIALOGUES & STRINGS LAYER (.XML / .8LD)";
                            title_color: #d28e1b;
                            save_btn_text: "Save Changes to Map Strings (.8LD)";
                            content <=> root.mat_json_text;
                            save_clicked => { root.save_m8ld(root.active_file_path, root.mat_json_text); }
                        }

                        // Context 13: UI Sprite Collection
                        if root.active_kind_id == 13: JsonEditorView {
                            title_text: "UI SPRITE COLLECTION EDITOR (ATLAS MAP)";
                            title_color: #63d297;
                            save_btn_text: "Save Changes to Sprite Collection";
                            content <=> root.mat_json_text;
                            save_clicked => { root.save_ui_sprite(root.active_file_path, root.mat_json_text); }
                        }

                        // Context 14: Lighting Set (.dta)
                        if root.active_kind_id == 14: JsonEditorView {
                            title_text: "LIGHTING SET & BINARY DATA (.DTA)";
                            title_color: #f0b132;
                            save_btn_text: "Save Changes to Lighting Set";
                            content <=> root.mat_json_text;
                            save_clicked => { root.save_dta(root.active_file_path, root.mat_json_text); }
                        }

                        // Context 15: Voice Package (.debug-vpk)
                        if root.active_kind_id == 15: JsonEditorView {
                            title_text: "VOICE PACKAGE DESCRIPTOR (.DEBUG-VPK / SPEECH MAPPING)";
                            title_color: #58a6ff;
                            save_btn_text: "Save Changes to Voice Package";
                            content <=> root.mat_json_text;
                            save_clicked => { root.save_vpk(root.active_file_path, root.mat_json_text); }
                        }
                    }
                }
            }
        }

        // TAB 1: SYSTEM LOGS
        if root.active_tab == 1: Rectangle {
            background: #2b2d31;
            border-color: #1f2023;
            border-width: 1px;
            border-radius: 4px;

            VerticalLayout {
                padding: 10px;
                TextEdit {
                    text <=> root.log_text;
                    read-only: true;
                    font-family: "Consolas";
                    font-size: 12px;
                }
            }
        }

        // BOTTOM STATUS BAR
        Rectangle {
            height: 30px;
            background: #2b2d31;
            border-radius: 4px;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;

                Text {
                    text: root.status_msg;
                    color: root.status_is_error ? #ff5555 : #4CAF50;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
    }
}
