import { TextEdit, Button, LineEdit, ListView } from "std-widgets.slint";
import { TabButton, CustomButton } from "./components/buttons.slint";
import { SectionTitle, SplitterBar } from "./components/common.slint";

export struct AssetItem {
    display_name: string,
    kind_name: string,
    icon: string,
    file_path: string,
    size_str: string,
    kind_id: int, // 0: Texture, 1: Audio, 2: Material, 3: Mesh, 4: Lua, 5: Generic, 6: UI, 7: Object, 8: Animation, 9: TerrainPalette, 10: Collision, 11: Environment, 12: M8LD Map Logic, 13: UI Sprite Collection
    is_modified: bool,
}

export component AppWindow inherits Window {
    title: "Overlord Modding Studio — Workspace";
    min-width: 1040px;
    min-height: 720px;
    preferred-width: 1320px;
    preferred-height: 840px;
    background: #141414;

    // View Tabs: 0 = Workspace, 1 = Terminal Log
    in-out property <int> active_tab: 0;
    in-out property <length> sidebar_width: 440px;

    // Workspace Data
    in-out property <string> active_project_dir: "";
    in-out property <[AssetItem]> asset_list: [];
    in-out property <string> filter_text: "";
    in-out property <int> selected_index: -1;
    in-out property <int> active_kind_id: 5;
    in-out property <string> active_file_path: "";
    in-out property <string> status_msg: "Ready.";
    in-out property <bool> status_is_error: false;
    in-out property <string> log_text: "System Ready.\n";

    // Active Asset Inspector States
    in-out property <image> tex_preview;
    in-out property <string> tex_info: "No texture loaded.";
    in-out property <bool> has_texture: false;
    in-out property <image> mesh_preview;
    in-out property <bool> has_mesh: false;
    in-out property <string> mat_json_text: "";
    in-out property <string> mesh_info: "No mesh loaded.";

    // File Dialog Callbacks
    callback browse_file() -> string;
    callback browse_folder() -> string;
    callback save_file() -> string;

    // Core Project Callbacks
    callback unpack_prp(string, string);
    callback pack_prp(string);
    callback load_project(string);
    callback clean_rebuild(string);
    callback revert_asset(string);
    callback open_assets_folder(string);
    callback create_patch(string, string, string);
    callback apply_patch(string, string);
    callback select_asset(int);
    callback filter_changed(string);

    // Interactive 3D Viewport Orbit Callback
    callback rotate_mesh_viewport(float, float);

    // Contextual Asset Operations Callbacks
    callback export_dds(string, string);
    callback import_dds(string, string);
    callback export_wav(string, string);
    callback import_wav(string, string);
    callback save_material(string, string);
    callback save_ui(string, string);
    callback save_object(string, string);
    callback save_terrain_palette(string, string);
    callback save_environment(string, string);
    callback save_m8ld(string, string);
    callback save_ui_sprite(string, string);

    // Localization Suite (8LD & XML - Single and Batch)
    callback decompile_8ld(string, string);
    callback compile_8ld(string, string);
    callback decompile_8ld_batch(string, string);
    callback compile_8ld_batch(string, string);

    callback export_mesh_obj(string, string);
    callback import_mesh_obj(string, string);
    callback export_terrain_obj(string, string);
    callback export_collision_glb(string, string);
    callback import_collision_glb(string, string);
    callback export_lua(string, string);
    callback import_lua(string, string);
    callback export_anim_glb(string, string);
    callback export_anim_json(string, string);

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // TOP NAVIGATION TAB BAR
        HorizontalLayout {
            spacing: 6px;
            height: 30px;

            TabButton {
                text: "Studio Workspace";
                active: root.active_tab == 0;
                accent-color: #f0b132;
                clicked => { root.active_tab = 0; }
            }

            TabButton {
                text: "Terminal Log";
                active: root.active_tab == 1;
                accent-color: #3e6a90;
                clicked => { root.active_tab = 1; }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            if root.active_project_dir != "": Text {
                text: "Project: " + root.active_project_dir;
                font-family: "Consolas";
                font-size: 11px;
                color: #f0b132;
                vertical-alignment: center;
                overflow: elide;
                max-width: 400px;
            }

            Text {
                text: "Items: " + root.asset_list.length;
                font-family: "Consolas";
                font-size: 11px;
                color: #cfcfcf;
                vertical-alignment: center;
            }
        }

        // TAB 0: UNIFIED WORKSPACE
        if root.active_tab == 0: VerticalLayout {
            spacing: 10px;

            // QUICK ACTIONS TOOLBAR (ORGANIZED IN 2 FUNCTIONAL ROWS)
            Rectangle {
                height: 82px;
                background: #2b2d31;
                border-color: #1f2023;
                border-width: 1px;
                border-radius: 6px;

                VerticalLayout {
                    padding: 8px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    alignment: center;

                    // ROW 1: PROJECT & ARCHIVE WORKFLOW
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        CustomButton {
                            icon: "📦";
                            text: "Unpack PRP...";
                            primary-color: #3e6a90;
                            min-w: 125px;
                            clicked => {
                                let src = root.browse_file();
                                if (src != "") {
                                    let dst = root.browse_folder();
                                    if (dst != "") { root.unpack_prp(src, dst); }
                                }
                            }
                        }

                        CustomButton {
                            icon: "📂";
                            text: "Open Project...";
                            primary-color: #4e5058;
                            min-w: 130px;
                            clicked => {
                                let path = root.browse_folder();
                                if (path != "") {
                                    root.load_project(path);
                                } else {
                                    let f = root.browse_file();
                                    if (f != "") { root.load_project(f); }
                                }
                            }
                        }

                        CustomButton {
                            icon: "📁";
                            text: "Assets Folder";
                            primary-color: #d28e1b;
                            min-w: 125px;
                            clicked => {
                                if (root.active_project_dir != "") {
                                    root.open_assets_folder(root.active_project_dir);
                                } else {
                                    let proj = root.browse_folder();
                                    if (proj != "") { root.open_assets_folder(proj); }
                                }
                            }
                        }

                        CustomButton {
                            icon: "🧹";
                            text: "Clean Rebuild";
                            primary-color: #636773;
                            min-w: 125px;
                            clicked => {
                                if (root.active_project_dir != "") {
                                    root.clean_rebuild(root.active_project_dir);
                                } else {
                                    let proj = root.browse_folder();
                                    if (proj != "") { root.clean_rebuild(proj); }
                                }
                            }
                        }

                        CustomButton {
                            icon: "💾";
                            text: "Pack to PRP";
                            primary-color: #23a55a;
                            min-w: 120px;
                            clicked => {
                                if (root.active_project_dir != "") {
                                    root.pack_prp(root.active_project_dir);
                                } else {
                                    let proj = root.browse_folder();
                                    if (proj != "") { root.pack_prp(proj); }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 1px;
                                background: #3f4248;
                                height: 20px;
                            }
                        }

                        CustomButton {
                            icon: "🩹";
                            text: "Create Patch...";
                            primary-color: #4e5058;
                            min-w: 125px;
                            clicked => {
                                let base = root.browse_folder();
                                if (base != "") {
                                    let mod_dir = root.browse_folder();
                                    if (mod_dir != "") {
                                        let out = root.save_file();
                                        if (out != "") { root.create_patch(base, mod_dir, out); }
                                    }
                                }
                            }
                        }

                        CustomButton {
                            icon: "✨";
                            text: "Apply Patch...";
                            primary-color: #3e6a90;
                            min-w: 120px;
                            clicked => {
                                let patch = root.browse_file();
                                if (patch != "") {
                                    let target = root.browse_folder();
                                    if (target != "") { root.apply_patch(target, patch); }
                                }
                            }
                        }
                    }

                    // ROW 2: LOCALIZATION SUITE (8LD / XML - Single & Batch)
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: "Localization:";
                            font-family: "Consolas";
                            font-size: 11px;
                            font-weight: 700;
                            color: #949ba4;
                            vertical-alignment: center;
                            width: 95px;
                        }

                        CustomButton {
                            icon: "🔓";
                            text: "8LD -> XML (1 file)";
                            primary-color: #d28e1b;
                            min-w: 155px;
                            clicked => {
                                let src = root.browse_file();
                                if (src != "") {
                                    let dst = root.browse_folder();
                                    if (dst != "") { root.decompile_8ld(src, dst); }
                                }
                            }
                        }

                        CustomButton {
                            icon: "🗂️";
                            text: "8LD -> XML (Batch)";
                            primary-color: #b57a16;
                            min-w: 160px;
                            clicked => {
                                let src = root.browse_folder();
                                if (src != "") {
                                    let dst = root.browse_folder();
                                    if (dst != "") { root.decompile_8ld_batch(src, dst); }
                                }
                            }
                        }

                        CustomButton {
                            icon: "🔒";
                            text: "XML -> 8LD (1 file)";
                            primary-color: #23a55a;
                            min-w: 155px;
                            clicked => {
                                let src = root.browse_file();
                                if (src != "") {
                                    let dst = root.browse_folder();
                                    if (dst != "") { root.compile_8ld(src, dst); }
                                }
                            }
                        }

                        CustomButton {
                            icon: "📦";
                            text: "XML -> 8LD (Batch)";
                            primary-color: #1c8849;
                            min-w: 160px;
                            clicked => {
                                let src = root.browse_folder();
                                if (src != "") {
                                    let dst = root.browse_folder();
                                    if (dst != "") { root.compile_8ld_batch(src, dst); }
                                }
                            }
                        }
                    }
                }
            }

            // WORKSPACE MAIN SPLITTER AREA
            HorizontalLayout {
                spacing: 0px;

                // --- LEFT EXPLORER SIDEBAR ---
                Rectangle {
                    width: root.sidebar_width;
                    background: #2b2d31;
                    border-color: #1f2023;
                    border-width: 1px;
                    border-radius: 4px;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        LineEdit {
                            text <=> root.filter_text;
                            placeholder-text: "🔍 Filter resources by name, ID or type...";
                            font-family: "Consolas";
                            font-size: 11px;
                            edited(text) => { root.filter_changed(text); }
                        }

                        Rectangle {
                            background: #111214;
                            border-radius: 4px;
                            clip: true;
                            vertical-stretch: 1;

                            ListView {
                                for item[idx] in root.asset_list: Rectangle {
                                    height: 34px;
                                    background: root.selected_index == idx ? #3e6a90 : (ta.has-hover ? #2c3e50 : (Math.mod(idx, 2) == 0 ? #18191b : #141517));

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;

                                        Text {
                                            text: item.icon;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 1px;
                                            horizontal-stretch: 1;

                                            HorizontalLayout {
                                                spacing: 4px;
                                                Text {
                                                    text: item.display_name;
                                                    color: #ffffff;
                                                    font-family: "Consolas";
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    overflow: elide;
                                                }

                                                if item.is_modified: Text {
                                                    text: "[MOD]";
                                                    color: #f0b132;
                                                    font-family: "Consolas";
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            Text {
                                                text: item.kind_name + " • " + item.size_str;
                                                color: root.selected_index == idx ? #dcdcdc : #949ba4;
                                                font-size: 10px;
                                            }
                                        }
                                    }

                                    ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.select_asset(idx); }
                                    }
                                }
                            }
                        }
                    }
                }

                SplitterBar {
                    target-width <=> root.sidebar_width;
                }

                // --- RIGHT DYNAMIC INSPECTOR PANE ---
                Rectangle {
                    horizontal-stretch: 1;
                    background: #18191b;
                    border-color: #1f2023;
                    border-width: 1px;
                    border-radius: 4px;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        // Header Information with Revert button
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: root.selected_index >= 0 && root.selected_index < root.asset_list.length ? root.asset_list[root.selected_index].display_name : "No Resource Selected";
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: #f0b132;
                                }

                                Text {
                                    text: root.active_file_path != "" ? root.active_file_path : "Select any item from the left resource explorer to inspect and edit.";
                                    font-family: "Consolas";
                                    font-size: 11px;
                                    color: #949ba4;
                                }
                            }

                            if root.active_file_path != "": CustomButton {
                                icon: "🔄";
                                text: "Reset to Vanilla";
                                primary-color: #8b3a3a;
                                min-w: 135px;
                                clicked => { root.revert_asset(root.active_file_path); }
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: #353535;
                        }

                        // CONTEXT 0: TEXTURES
                        if root.active_kind_id == 0: VerticalLayout {
                            spacing: 10px;
                            vertical-stretch: 1;

                            HorizontalLayout {
                                spacing: 8px;
                                CustomButton {
                                    icon: "📥";
                                    text: "Export to Image";
                                    primary-color: #3e6a90;
                                    min-w: 130px;
                                    clicked => {
                                        let out = root.save_file();
                                        if (out != "") { root.export_dds(root.active_file_path, out); }
                                    }
                                }

                                CustomButton {
                                    icon: "📤";
                                    text: "Replace from Image";
                                    primary-color: #23a55a;
                                    min-w: 140px;
                                    clicked => {
                                        let inp = root.browse_file();
                                        if (inp != "") { root.import_dds(root.active_file_path, inp); }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: root.tex_info;
                                    font-family: "Consolas";
                                    color: #cfcfcf;
                                    vertical-alignment: center;
                                    font-size: 11px;
                                }
                            }

                            Rectangle {
                                background: #111214;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #353535;
                                clip: true;
                                vertical-stretch: 1;

                                Image {
                                    source: root.tex_preview;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                }
                            }
                        }

                        // CONTEXT 1: AUDIO
                        if root.active_kind_id == 1: VerticalLayout {
                            spacing: 12px;
                            alignment: start;

                            SectionTitle {
                                text: "AUDIO EXTRACTION & REPLACEMENT";
                                text-color: #3e6a90;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                CustomButton {
                                    icon: "📥";
                                    text: "Export to .WAV";
                                    primary-color: #3e6a90;
                                    min-w: 125px;
                                    clicked => {
                                        let out = root.save_file();
                                        if (out != "") { root.export_wav(root.active_file_path, out); }
                                    }
                                }

                                CustomButton {
                                    icon: "📤";
                                    text: "Replace from .WAV";
                                    primary-color: #23a55a;
                                    min-w: 135px;
                                    clicked => {
                                        let inp = root.browse_file();
                                        if (inp != "") { root.import_wav(root.active_file_path, inp); }
                                    }
                                }
                            }
                        }

                        // CONTEXT 2: MATERIALS
                        if root.active_kind_id == 2: VerticalLayout {
                            spacing: 8px;
                            vertical-stretch: 1;

                            HorizontalLayout {
                                spacing: 8px;
                                CustomButton {
                                    icon: "💾";
                                    text: "Save Changes to Material";
                                    primary-color: #23a55a;
                                    min-w: 175px;
                                    clicked => { root.save_material(root.active_file_path, root.mat_json_text); }
                                }
                            }

                            Rectangle {
                                background: #111214;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #353535;
                                vertical-stretch: 1;

                                TextEdit {
                                    text <=> root.mat_json_text;
                                    font-family: "Consolas";
                                    font-size: 11px;
                                }
                            }
                        }

                        // CONTEXT 3: 3D MESH & TERRAIN
                        if root.active_kind_id == 3: VerticalLayout {
                            spacing: 10px;
                            vertical-stretch: 1;

                            SectionTitle {
                                text: "3D GEOMETRY, MIKKTSPACE TANGENTS & VIEWPORT";
                                text-color: #f0b132;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                CustomButton {
                                    icon: "🗿";
                                    text: "Export to .OBJ / .GLB";
                                    primary-color: #3e6a90;
                                    min-w: 145px;
                                    clicked => {
                                        let out = root.save_file();
                                        if (out != "") { root.export_mesh_obj(root.active_file_path, out); }
                                    }
                                }

                                CustomButton {
                                    icon: "📤";
                                    text: "Replace from .OBJ / .GLB";
                                    primary-color: #23a55a;
                                    min-w: 155px;
                                    clicked => {
                                        let inp = root.browse_file();
                                        if (inp != "") { root.import_mesh_obj(root.active_file_path, inp); }
                                    }
                                }

                                CustomButton {
                                    icon: "⛰️";
                                    text: "Export Terrain to 3D";
                                    primary-color: #4e5058;
                                    min-w: 145px;
                                    clicked => {
                                        let out = root.save_file();
                                        if (out != "") { root.export_terrain_obj(root.active_file_path, out); }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: root.mesh_info;
                                    font-family: "Consolas";
                                    color: #cfcfcf;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }

                            // Interactive 3D Orbit Viewport
                            Rectangle {
                                background: #111214;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #353535;
                                clip: true;
                                vertical-stretch: 1;

                                Image {
                                    source: root.mesh_preview;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                }

                                if !root.has_mesh: Text {
                                    text: "Select a 3D Mesh (.bin) to preview model in interactive 3D viewport";
                                    color: #808080;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }

                                property <length> drag_last_x: 0px;
                                property <length> drag_last_y: 0px;
                                property <bool> is_dragging: false;

                                TouchArea {
                                    mouse-cursor: grab;
                                    moved => {
                                        if (self.pressed) {
                                            if (!is_dragging) {
                                                is_dragging = true;
                                                drag_last_x = self.mouse-x;
                                                drag_last_y = self.mouse-y;
                                            } else {
                                                let dx = (self.mouse-x - drag_last_x) / 1px;
                                                let dy = (self.mouse-y - drag_last_y) / 1px;
                                                drag_last_x = self.mouse-x;
                                                drag_last_y = self.mouse-y;
                                                if (dx != 0 || dy != 0) {
                                                    root.rotate_mesh_viewport(dx / 80.0, dy / 80.0);
                                                }
                                            }
                                        } else {
                                            is_dragging = false;
                                        }
                                    }
                                }
                            }
                        }

                        // CONTEXT 4: LUA SCRIPT
                        if root.active_kind_id == 4: VerticalLayout {
                            spacing: 12px;
                            alignment: start;

                            SectionTitle {
                                text: "COMPILED SCRIPT (LUA 5.0.2)";
                                text-color: #f0b132;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                CustomButton {
                                    icon: "📥";
                                    text: "Export to .luac";
                                    primary-color: #3e6a90;
                                    min-w: 125px;
                                    clicked => {
                                        let out = root.save_file();
                                        if (out != "") { root.export_lua(root.active_file_path, out); }
                                    }
                                }

                                CustomButton {
                                    icon: "📤";
                                    text: "Replace from .luac";
                                    primary-color: #23a55a;
                                    min-w: 135px;
                                    clicked => {
                                        let inp = root.browse_file();
                                        if (inp != "") { root.import_lua(root.active_file_path, inp); }
                                    }
                                }
                            }
                        }

                        // CONTEXT 5: GENERIC / RAW
                        if root.active_kind_id == 5: VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.selected_index >= 0 ? "Generic data chunk. Raw binary operations only." : "No resource selected. Click an item in the left explorer.";
                                color: #808080;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }

                        // CONTEXT 6: UI LAYOUT EDITOR
                        if root.active_kind_id == 6: VerticalLayout {
                            spacing: 8px;
                            vertical-stretch: 1;

                            SectionTitle {
                                text: "UI LAYOUT EDITOR (MENU & HUD)";
                                text-color: #63d297;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                CustomButton {
                                    icon: "💾";
                                    text: "Save Changes to UI Layout";
                                    primary-color: #23a55a;
                                    min-w: 195px;
                                    clicked => { root.save_ui(root.active_file_path, root.mat_json_text); }
                                }
                            }

                            Rectangle {
                                background: #111214;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #353535;
                                vertical-stretch: 1;

                                TextEdit {
                                    text <=> root.mat_json_text;
                                    font-family: "Consolas";
                                    font-size: 11px;
                                }
                            }
                        }

                        // CONTEXT 7: 3D OBJECT ENTITY EDITOR
                        if root.active_kind_id == 7: VerticalLayout {
                            spacing: 8px;
                            vertical-stretch: 1;

                            SectionTitle {
                                text: "3D OBJECT ENTITY EDITOR (SCENE GRAPH)";
                                text-color: #3e6a90;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                CustomButton {
                                    icon: "💾";
                                    text: "Save Changes to Object Entity";
                                    primary-color: #23a55a;
                                    min-w: 210px;
                                    clicked => { root.save_object(root.active_file_path, root.mat_json_text); }
                                }
                            }

                            Rectangle {
                                background: #111214;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #353535;
                                vertical-stretch: 1;

                                TextEdit {
                                    text <=> root.mat_json_text;
                                    font-family: "Consolas";
                                    font-size: 11px;
                                }
                            }
                        }

                        // CONTEXT 8: SKELETAL ANIMATION CLIP
                        if root.active_kind_id == 8: VerticalLayout {
                            spacing: 8px;
                            vertical-stretch: 1;

                            SectionTitle {
                                text: "SKELETAL ANIMATION CLIP (TIMELINE & CHANNELS)";
                                text-color: #f0b132;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                CustomButton {
                                    icon: "🎬";
                                    text: "Export to .GLB";
                                    primary-color: #3e6a90;
                                    min-w: 130px;
                                    clicked => {
                                        let out = root.save_file();
                                        if (out != "") { root.export_anim_glb(root.active_file_path, out); }
                                    }
                                }

                                CustomButton {
                                    icon: "📋";
                                    text: "Export to .JSON";
                                    primary-color: #4e5058;
                                    min-w: 130px;
                                    clicked => {
                                        let out = root.save_file();
                                        if (out != "") { root.export_anim_json(root.active_file_path, out); }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: root.mesh_info;
                                    font-family: "Consolas";
                                    color: #cfcfcf;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                background: #111214;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #353535;
                                vertical-stretch: 1;

                                TextEdit {
                                    text <=> root.mat_json_text;
                                    read-only: true;
                                    font-family: "Consolas";
                                    font-size: 11px;
                                }
                            }
                        }

                        // CONTEXT 9: TERRAIN TEXTURE PALETTE & BIOME
                        if root.active_kind_id == 9: VerticalLayout {
                            spacing: 8px;
                            vertical-stretch: 1;

                            SectionTitle {
                                text: "TERRAIN TEXTURE PALETTE & BIOME EDITOR";
                                text-color: #f0b132;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                CustomButton {
                                    icon: "💾";
                                    text: "Save Changes to Terrain Palette";
                                    primary-color: #23a55a;
                                    min-w: 220px;
                                    clicked => { root.save_terrain_palette(root.active_file_path, root.mat_json_text); }
                                }
                            }

                            Rectangle {
                                background: #111214;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #353535;
                                vertical-stretch: 1;

                                TextEdit {
                                    text <=> root.mat_json_text;
                                    font-family: "Consolas";
                                    font-size: 11px;
                                }
                            }
                        }

                        // CONTEXT 10: 3D COLLISION BOUNDARY EDITOR (.CLB)
                        if root.active_kind_id == 10: VerticalLayout {
                            spacing: 10px;
                            vertical-stretch: 1;

                            SectionTitle {
                                text: "3D COLLISION BOUNDARY EDITOR (.CLB / OBB)";
                                text-color: #4CAF50;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                CustomButton {
                                    icon: "🧱";
                                    text: "Export to 3D .GLB";
                                    primary-color: #3e6a90;
                                    min-w: 145px;
                                    clicked => {
                                        let out = root.save_file();
                                        if (out != "") { root.export_collision_glb(root.active_file_path, out); }
                                    }
                                }

                                CustomButton {
                                    icon: "📤";
                                    text: "Replace from 3D .GLB";
                                    primary-color: #23a55a;
                                    min-w: 155px;
                                    clicked => {
                                        let inp = root.browse_file();
                                        if (inp != "") { root.import_collision_glb(root.active_file_path, inp); }
                                    }
                                }
                            }

                            Rectangle {
                                background: #111214;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #353535;
                                vertical-stretch: 1;

                                TextEdit {
                                    text <=> root.mat_json_text;
                                    font-family: "Consolas";
                                    font-size: 11px;
                                }
                            }
                        }

                        // CONTEXT 11: ENVIRONMENT (.ENV) PROFILE
                        if root.active_kind_id == 11: VerticalLayout {
                            spacing: 8px;
                            vertical-stretch: 1;

                            SectionTitle {
                                text: "ENVIRONMENT, SKY & POST-PROCESSING PROFILE (.ENV)";
                                text-color: #63d297;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                CustomButton {
                                    icon: "💾";
                                    text: "Save Changes to Environment Profile";
                                    primary-color: #23a55a;
                                    min-w: 240px;
                                    clicked => { root.save_environment(root.active_file_path, root.mat_json_text); }
                                }
                            }

                            Rectangle {
                                background: #111214;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #353535;
                                vertical-stretch: 1;

                                TextEdit {
                                    text <=> root.mat_json_text;
                                    font-family: "Consolas";
                                    font-size: 11px;
                                }
                            }
                        }

                        // CONTEXT 12: M8LD / LANGUAGE STRINGS XML EDITOR
                        if root.active_kind_id == 12: VerticalLayout {
                            spacing: 8px;
                            vertical-stretch: 1;

                            SectionTitle {
                                text: "LEVEL LOGIC, DIALOGUES & STRINGS LAYER (.XML / .8LD)";
                                text-color: #d28e1b;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                CustomButton {
                                    icon: "💾";
                                    text: "Save Changes to Map Strings (.8LD)";
                                    primary-color: #23a55a;
                                    min-w: 230px;
                                    clicked => { root.save_m8ld(root.active_file_path, root.mat_json_text); }
                                }
                            }

                            Rectangle {
                                background: #111214;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #353535;
                                vertical-stretch: 1;

                                TextEdit {
                                    text <=> root.mat_json_text;
                                    font-family: "Consolas";
                                    font-size: 11px;
                                }
                            }
                        }

                        // CONTEXT 13: UI SPRITE COLLECTION EDITOR
                        if root.active_kind_id == 13: VerticalLayout {
                            spacing: 10px;
                            vertical-stretch: 1;

                            SectionTitle {
                                text: "UI SPRITE COLLECTION EDITOR (ATLAS MAP)";
                                text-color: #63d297;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                CustomButton {
                                    icon: "💾";
                                    text: "Save Changes to Sprite Collection";
                                    primary-color: #23a55a;
                                    min-w: 260px;
                                    clicked => { root.save_ui_sprite(root.active_file_path, root.mat_json_text); }
                                }
                            }

                            Rectangle {
                                background: #111214;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #353535;
                                vertical-stretch: 1;

                                TextEdit {
                                    text <=> root.mat_json_text;
                                    font-family: "Consolas";
                                    font-size: 11px;
                                }
                            }
                        }
                    }
                }
            }
        }

        // TAB 1: SYSTEM LOGS
        if root.active_tab == 1: Rectangle {
            background: #2b2d31;
            border-color: #1f2023;
            border-width: 1px;
            border-radius: 4px;

            VerticalLayout {
                padding: 10px;
                TextEdit {
                    text <=> root.log_text;
                    read-only: true;
                    font-family: "Consolas";
                    font-size: 12px;
                }
            }
        }

        // BOTTOM STATUS BAR
        Rectangle {
            height: 30px;
            background: #2b2d31;
            border-radius: 4px;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;

                Text {
                    text: root.status_msg;
                    color: root.status_is_error ? #ff5555 : #4CAF50;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
    }
}
